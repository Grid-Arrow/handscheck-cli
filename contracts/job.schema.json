      },
      "title": "Open Findings",
      "type": "array"
    },
    "options": {
      "$ref": "#/$defs/RunOptions"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "previous_snapshots": {
      "additionalProperties": {
