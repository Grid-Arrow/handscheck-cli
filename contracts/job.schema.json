        "type": "string"
      },
      "title": "Suppressions",
      "type": "array"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "triage": {
      "anyOf": [
        {
          "$ref": "#/$defs/TriageInput"
        },
        {
